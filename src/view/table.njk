{% extends "layout.njk" %}

{% block content %}
<section class="page-head">
  <div>
    <h1>{{ title }}</h1>
    <p class="subtitle">Усього записів: <span data-table-count>0</span></p>
  </div>
  {% if canManage %}
    <a class="btn btn-primary" href="{{ createHref }}">
      <svg class="btn-icon" viewBox="0 0 20 20" aria-hidden="true"><path d="M10 4v12M4 10h12"></path></svg>
      Додати запис
    </a>
  {% endif %}
</section>

<section class="table-card">
  <table>
    <colgroup>
      {% for width in widths %}<col style="width: {{ width }}">{% endfor %}
      {% if hasDetail %}<col class="details-width">{% endif %}
      {% if canManage %}<col class="actions-width">{% endif %}
    </colgroup>
    <thead>
      <tr>
        {% for column in columns %}<th>{{ column }}</th>{% endfor %}
        {% if hasDetail %}<th class="actions-col">Деталі</th>{% endif %}
        {% if canManage %}<th class="actions-col">Дії</th>{% endif %}
      </tr>
    </thead>
    <tbody
      data-table-body
      data-key="{{ key }}"
      data-manage="{{ 'true' if canManage else 'false' }}"
      data-detail="{{ 'true' if hasDetail else 'false' }}"
      data-center="{{ center }}"
      data-colspan="{{ colspan }}"
      data-start="{{ start }}"
    >
      <tr><td class="empty-cell" colspan="{{ colspan }}">Завантаження...</td></tr>
    </tbody>
  </table>
</section>
{% endblock %}
