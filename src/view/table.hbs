<section class="page-head">
  <div>
    <h1>{{title}}</h1>
    <p class="subtitle">Усього записів: <span data-table-count>0</span></p>
  </div>
  {{#if canManage}}
    <a class="btn btn-primary" href="{{createHref}}">
      <svg class="btn-icon" viewBox="0 0 20 20" aria-hidden="true">
        <path d="M10 4v12M4 10h12"></path>
      </svg>
      Додати запис
    </a>
  {{/if}}
</section>

<section class="table-card">
  <table>
    <colgroup>
      {{#each widths}}<col style="width: {{this}}">{{/each}}
      {{#if hasDetail}}<col class="details-width">{{/if}}
      {{#if canManage}}<col class="actions-width">{{/if}}
    </colgroup>
    <thead>
      <tr>
        {{#each columns}}<th>{{this}}</th>{{/each}}
        {{#if hasDetail}}<th class="actions-col">Деталі</th>{{/if}}
        {{#if canManage}}<th class="actions-col">Дії</th>{{/if}}
      </tr>
    </thead>
    <tbody
      data-table-body
      data-key="{{key}}"
      data-manage="{{canManage}}"
      data-detail="{{hasDetail}}"
      data-center="{{center}}"
      data-colspan="{{colspan}}"
      data-start="{{start}}"
    >
      <tr><td class="empty-cell" colspan="{{colspan}}">Завантаження...</td></tr>
    </tbody>
  </table>
</section>
