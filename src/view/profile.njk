{% extends "layout.njk" %}

{% block content %}
<section class="page-head" data-profile-page>
  <div>
    <h1>Профіль</h1>
    <p class="subtitle"><span data-profile-name></span> · {{ roleLabel }}</p>
  </div>
</section>

<section class="profile-summary">
  <div class="profile-avatar" aria-hidden="true">
    <svg viewBox="0 0 24 24"><use href="#icon-profile"></use></svg>
  </div>
  <div class="profile-summary-main">
    <h2 data-profile-name></h2>
    <span>{{ roleLabel }}</span>
  </div>
  <dl class="profile-facts">
    <div><dt>Email</dt><dd data-profile-email></dd></div>
    <div data-profile-fact="phone"><dt>Телефон</dt><dd data-profile-phone></dd></div>
    <div data-profile-fact="city"><dt>Місто</dt><dd data-profile-city></dd></div>
    <div data-profile-fact="website"><dt>Сайт</dt><dd data-profile-website></dd></div>
  </dl>
</section>

<div class="profile-grid">
  <section class="profile-card">
    <h2>Особисті дані</h2>
    <p class="profile-hint">Ці дані використовуються в квитках і службових записах.</p>

    {% if profileErrors._form %}
      <div class="alert alert-error">{{ profileErrors._form }}</div>
    {% endif %}

    <form method="post" action="/profile" novalidate data-ajax data-api data-api-action="/api/profile" data-method="PATCH" data-redirect="/profile" data-profile-form>
      <div class="form-grid">
        {% for field in fields %}
          <div class="field{% if field.wide %} field-wide{% endif %}{% if field.error %} field-invalid{% endif %}">
            <label for="profile-{{ field.name }}">{{ field.label }}</label>

            {% if field.type == 'textarea' %}
              <textarea id="profile-{{ field.name }}" name="{{ field.name }}" rows="{{ field.rows or 4 }}" placeholder="{{ field.placeholder }}">{{ field.value }}</textarea>
            {% else %}
              <input id="profile-{{ field.name }}" type="{{ field.inputType }}" name="{{ field.name }}" value="{{ field.value }}" placeholder="{{ field.placeholder }}" autocomplete="off">
            {% endif %}

            {% if field.error %}<p class="field-error">{{ field.error }}</p>{% endif %}
          </div>
        {% endfor %}
      </div>
      <div class="form-actions">
        <button class="btn btn-primary" type="submit">Зберегти зміни</button>
      </div>
    </form>
  </section>

  <section class="profile-card">
    <h2>Зміна пароля</h2>
    <p class="profile-hint">Щонайменше 12 символів, літери й цифри.</p>

    <form method="post" action="/profile" novalidate data-ajax data-api data-api-action="/api/profile/password" data-redirect="/profile">
      <div class="field{% if passwordErrors.currentPassword %} field-invalid{% endif %}">
        <label for="current-password">Поточний пароль</label>
        <input id="current-password" type="password" name="currentPassword" autocomplete="current-password">
        {% if passwordErrors.currentPassword %}<p class="field-error">{{ passwordErrors.currentPassword }}</p>{% endif %}
      </div>
      <div class="field{% if passwordErrors.newPassword %} field-invalid{% endif %}">
        <label for="new-password">Новий пароль</label>
        <input id="new-password" type="password" name="newPassword" autocomplete="new-password">
        {% if passwordErrors.newPassword %}<p class="field-error">{{ passwordErrors.newPassword }}</p>{% endif %}
      </div>
      <div class="field{% if passwordErrors.confirmPassword %} field-invalid{% endif %}">
        <label for="confirm-password">Повторіть новий пароль</label>
        <input id="confirm-password" type="password" name="confirmPassword" autocomplete="new-password">
        {% if passwordErrors.confirmPassword %}<p class="field-error">{{ passwordErrors.confirmPassword }}</p>{% endif %}
      </div>
      <div class="form-actions">
        <button class="btn btn-primary" type="submit">Змінити пароль</button>
      </div>
    </form>
  </section>
</div>
{% endblock %}
