<div class="modal" id="password-modal" hidden aria-hidden="true">
  <div class="modal-backdrop" data-password-close></div>
  <div class="modal-card password-card" role="dialog" aria-modal="true" aria-labelledby="password-title">
    <div class="modal-head">
      <div class="modal-icon password-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24"><use href="#icon-key"></use></svg>
      </div>
      <h2 id="password-title">Скидання пароля</h2>
    </div>

    <p>Користувач: <strong id="password-user"></strong></p>

    <form method="post" action="" id="password-form" novalidate>
      <div class="modal-actions">
        <button type="button" class="btn btn-ghost" data-password-close>Скасувати</button>
        <button type="submit" class="btn btn-primary" id="password-submit">Згенерувати новий пароль</button>
      </div>
    </form>

    <div id="password-result" hidden>
      <p class="password-note">Скопіюйте пароль і надішліть його користувачу.</p>
      <div class="password-reveal">
        <code id="password-value"></code>
        <button type="button" class="btn btn-ghost btn-small" id="password-copy">Скопіювати</button>
      </div>
      <div class="modal-actions">
        <button type="button" class="btn btn-primary" data-password-close>Готово</button>
      </div>
    </div>
  </div>
</div>
