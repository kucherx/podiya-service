<nav class="crumbs">
  <a href="/events">Події</a>
  <span class="crumb-sep">/</span>
  <span>{{event.title}}</span>
</nav>

<section class="event-hero">
  <div>
    <p class="event-status">{{formatStatus event.status}}</p>
    <h1>{{event.title}}</h1>
    <p class="event-lead">{{event.description}}</p>
  </div>
  <dl class="event-facts">
    <div><dt>Початок</dt><dd>{{formatDate event.startsAt}}</dd></div>
    <div><dt>Завершення</dt><dd>{{formatDate event.endsAt}}</dd></div>
    <div><dt>Локація</dt><dd>{{event.location.name}}</dd></div>
    <div><dt>Організатор</dt><dd>{{event.organizer.name}}</dd></div>
  </dl>
</section>

<section class="event-section">
  <h2>Категорії квитків</h2>
  <div class="category-grid">
    {{#each categories}}
      <article class="category-card{{#unless available}} category-sold{{/unless}}">
        <h3>{{name}}</h3>
        <p class="category-price">{{formatMoney price}}</p>
        <p class="category-stock">Доступно: {{available}}</p>
        {{#if @root.canBuy}}
          {{#if available}}
            <form class="buy-form" method="post" action="/events/{{@root.event.id}}/buy" data-ajax novalidate>
              <input type="hidden" name="categoryId" value="{{id}}">
              <label class="buy-qty" for="buy-qty-{{id}}">
                <span>Кількість</span>
                <input id="buy-qty-{{id}}" type="number" name="quantity" value="1" min="1" max="{{available}}" step="1">
              </label>
              <button class="btn btn-primary btn-small" type="submit">Купити</button>
            </form>
          {{else}}
            <span class="badge badge-muted">Продано</span>
          {{/if}}
        {{/if}}
      </article>
    {{else}}
      <p class="subtitle">Для цієї події ще не додано категорій.</p>
    {{/each}}
  </div>

  {{#unless currentUser}}
    <p class="event-login-hint">
      Щоб придбати квиток, увійдіть у свій акаунт.
      <button type="button" class="link-button" data-open-auth="login">Увійти</button>
    </p>
  {{/unless}}
</section>

{{#if ownTickets}}
  <section class="event-section">
    <h2>Мої квитки на цю подію</h2>
    <div class="table-card">
      <table>
        <thead>
          <tr><th>Код</th><th>Категорія</th><th>Статус</th><th>Оплата</th><th>К-сть</th><th>Сума</th><th>Дія</th></tr>
        </thead>
        <tbody>
          {{#each ownTickets}}
            <tr id="ticket-{{id}}"{{#if (eq id @root.highlightTicketId)}} class="ticket-highlight"{{/if}}>
              <td class="center">{{code}}</td>
              <td>{{category.name}}</td>
              <td class="center">{{formatStatus status}}</td>
              <td class="center">{{#if paidAt}}Оплачено{{else}}Очікує{{/if}}</td>
              <td class="center">{{quantity}}</td>
              <td class="center">{{formatMoney total}}</td>
              <td class="actions-cell">
                {{#if (eq status 'reserved')}}
                  <form method="post" action="/tickets/{{id}}/cancel" data-ajax novalidate>
                    <button class="btn btn-small btn-danger" type="submit">Скасувати</button>
                  </form>
                {{/if}}
              </td>
            </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  </section>
{{/if}}

{{#if manager}}
  <section class="event-section">
    <h2>Квитки події</h2>
    <div class="table-card">
      <table>
        <thead>
          <tr>
            <th>Код</th><th>Категорія</th><th>Клієнт</th><th>Контакти</th>
            <th>Статус</th><th>Оплата</th><th>Присутність</th><th>К-сть</th><th>Сума</th><th>Дії</th>
          </tr>
        </thead>
        <tbody>
          {{#each tickets}}
            <tr id="ticket-{{id}}"{{#if (eq id @root.highlightTicketId)}} class="ticket-highlight"{{/if}}>
              <td class="center">{{code}}</td>
              <td>{{category.name}}</td>
              <td>{{#if client}}{{client.fullName}}{{else}}—{{/if}}</td>
              <td>{{#if client}}{{client.email}} · {{client.phone}}{{else}}—{{/if}}</td>
              <td class="center">{{formatStatus status}}</td>
              <td class="center">{{#if paidAt}}Так{{else}}Ні{{/if}}</td>
              <td class="center">{{#if checkedInAt}}Так{{else}}Ні{{/if}}</td>
              <td class="center">{{quantity}}</td>
              <td class="center">{{formatMoney total}}</td>
              <td class="actions-cell">
                {{#if (eq status 'reserved')}}
                  <form method="post" action="/tickets/{{id}}/pay" data-ajax novalidate>
                    <button class="btn btn-small btn-ghost" type="submit">Підтвердити оплату</button>
                  </form>
                {{/if}}
                {{#if (eq status 'sold')}}
                  {{#unless checkedInAt}}
                    <form method="post" action="/tickets/{{id}}/check-in" data-ajax novalidate>
                      <button class="btn btn-small btn-ghost" type="submit">Відмітити</button>
                    </form>
                  {{/unless}}
                {{/if}}
                {{#unless (eq status 'cancelled')}}
                  <form method="post" action="/tickets/{{id}}/cancel" data-ajax novalidate>
                    <button class="btn btn-small btn-danger" type="submit">Скасувати</button>
                  </form>
                {{/unless}}
              </td>
            </tr>
          {{else}}
            <tr><td class="empty-cell" colspan="10">Квитків ще немає</td></tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  </section>
{{/if}}
