<section class="page-head">
  <div>
    <h1>Користувачі</h1>
    <p class="subtitle">Усього акаунтів: <span data-users-count>0</span></p>
  </div>
  <a class="btn btn-primary" href="/users/new">
    <svg class="btn-icon" viewBox="0 0 20 20" aria-hidden="true">
      <path d="M10 4v12M4 10h12"></path>
    </svg>
    Додати користувача
  </a>
</section>

<section class="table-card">
  <table>
    <colgroup>
      <col style="width: 6%">
      <col style="width: 24%">
      <col style="width: 26%">
      <col style="width: 14%">
      <col style="width: 30%">
    </colgroup>
    <thead>
      <tr>
        <th>ID</th>
        <th>Ім’я</th>
        <th>Email</th>
        <th>Роль</th>
        <th>Дії</th>
      </tr>
    </thead>
    <tbody data-users-body data-current="{{currentId}}">
      <tr><td class="empty-cell" colspan="5">Завантаження...</td></tr>
    </tbody>
  </table>
</section>
