<!DOCTYPE html>
<html lang="uk">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="stylesheet" href="/css/base.css">
  <link rel="stylesheet" href="/css/nav.css">
  <link rel="stylesheet" href="/css/header.css">
  <link rel="stylesheet" href="/css/controls.css">
  <link rel="stylesheet" href="/css/table.css">
  <link rel="stylesheet" href="/css/form.css">
  <link rel="stylesheet" href="/css/multi-select.css">
  <link rel="stylesheet" href="/css/hints.css">
  <link rel="stylesheet" href="/css/stepper.css">
  <link rel="stylesheet" href="/css/select.css">
  <link rel="stylesheet" href="/css/date.css">
  <link rel="stylesheet" href="/css/calendar.css">
  <link rel="stylesheet" href="/css/calendar-footer.css">
  <link rel="stylesheet" href="/css/modal.css">
  <link rel="stylesheet" href="/css/auth.css">
  <link rel="stylesheet" href="/css/profile.css">
  <title>{{title}} — Менеджер подій</title>
</head>
<body>
  {{> icons}}
  <header class="site-header">
    <div class="header-inner">
      <a class="brand" href="/">
        <img class="brand-mark" src="/favicon.svg" alt="">
        <span class="brand-name">Менеджер подій</span>
      </a>
      <nav class="nav">
        {{#each nav}}
          <a href="{{href}}"{{#if (eq key @root.active)}} aria-current="page"{{/if}}>
            <svg class="nav-icon" aria-hidden="true"><use href="#icon-{{key}}"></use></svg>
            <span>{{label}}</span>
          </a>
        {{/each}}
      </nav>
      <div class="header-actions">
        {{#if currentUser}}
          <a class="user-link" href="/profile">
            <svg class="nav-icon" aria-hidden="true"><use href="#icon-profile"></use></svg>
            <span class="user-meta">
              <strong title="{{currentUser.email}}">{{currentUser.name}}</strong>
              <small>{{roleLabel}}</small>
            </span>
          </a>
          <form method="post" action="/auth/logout">
            <button class="btn btn-ghost btn-small" type="submit">
              <svg class="nav-icon" aria-hidden="true"><use href="#icon-logout"></use></svg>
              Вийти
            </button>
          </form>
        {{else}}
          <button class="btn btn-ghost" type="button" data-open-auth="login">
            <svg class="nav-icon" aria-hidden="true"><use href="#icon-login"></use></svg>
            Увійти
          </button>
          <button class="btn btn-primary" type="button" data-open-auth="register">
            <svg class="nav-icon" aria-hidden="true"><use href="#icon-register"></use></svg>
            Реєстрація
          </button>
        {{/if}}
      </div>
    </div>
  </header>
  <main class="page">
    {{#if flash}}
      <div class="alert alert-{{flash.type}}" role="status">{{flash.text}}</div>
    {{/if}}
    {{#if message.text}}
      <div class="alert alert-{{message.type}}" role="status">{{message.text}}</div>
    {{/if}}
    {{{body}}}
  </main>
  {{#unless currentUser}}{{> auth-modals}}{{/unless}}
  {{> delete-modal}}
  <script src="/js/auth.js" defer></script>
  <script src="/js/select.js" defer></script>
  <script src="/js/multi-select.js" defer></script>
  <script src="/js/phone-hint.js" defer></script>
  <script type="module" src="/js/date-picker.js"></script>
  <script src="/js/stepper.js" defer></script>
  <script src="/js/modal.js" defer></script>
  <script src="/js/ajax.js" defer></script>
</body>
</html>
