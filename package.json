{
  "name": "podiya",
  "version": "2.0.0",
  "description": "Платформа івент-менеджменту та продажу квитків на Express, TypeORM, PostgreSQL, Nunjucks і Passport",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:reset": "node scripts/reset-db.mjs",
    "db:generate": "node scripts/generate-seed.mjs"
  },
  "keywords": [
    "nodejs",
    "express",
    "typeorm",
    "postgresql",
    "nunjucks",
    "passport",
    "events",
    "tickets"
  ],
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-session": "^1.19.0",
    "nunjucks": "^3.2.4",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^1.1.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
