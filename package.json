{
  "name": "podiya",
  "version": "1.0.0",
  "description": "Платформа івент-менеджменту та продажу квитків на Express.js, TypeORM і SQLite",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:seed": "node src/db/seed/run.js"
  },
  "keywords": [
    "nodejs",
    "express",
    "typeorm",
    "sqlite",
    "events",
    "tickets"
  ],
  "dependencies": {
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-handlebars": "^9.0.4",
    "reflect-metadata": "^0.2.2",
    "sql.js": "^1.15.2",
    "typeorm": "^1.1.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
